---
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../i18n/ui';
import CtaBlock from './CtaBlock.astro';
import { Image } from 'astro:assets';
import { works } from '../data/works';
// プロフィール写真が届くまでは、作品の写真を「作品」と明記して置く
const piece = works.find((w) => w.id === 'look-01')!;

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const d = ui.designer;
---

<Base lang={lang} path="designer/" title={ui.seo.designer.title} description={ui.seo.designer.desc}>
  <header class="page-head wrap">
    <h1>{d.name}</h1>
    {d.kana && <p class="sub">{d.kana}</p>}
    <p class="sub">{d.role}</p>
  </header>

  <section class="section">
    <div class="wrap profile">
      <figure>
        <Image src={piece.images[0]} alt={piece.name[lang]} widths={[480, 800]} sizes="(max-width: 800px) 100vw, 40vw" />
        <figcaption class="sub">{d.photoCaption}</figcaption>
      </figure>
      <div>{d.profile.map((p) => <p>{p}</p>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <h2>{d.viewTitle}</h2>
      {d.view.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{d.careerTitle}</h2>
      <dl class="career">
        {d.career.map((c) => <div><dt>{c.h}</dt><dd>{c.p}</dd></div>)}
      </dl>
    </div>
  </section>

  <CtaBlock lang={lang} />
</Base>

<style>
  .profile {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: 56px;
    align-items: start;
  }
  .profile figure {
    margin: 0;
  }
  .profile :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
  figcaption {
    font-size: 12px;
    margin-top: 8px;
  }
  .profile p:first-child {
    margin-top: 0;
  }
  .career {
    margin: 0;
  }
  .career div {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .career dt {
    color: var(--gold);
  }
  .career dd {
    margin: 0;
    font-size: 14px;
  }
  @media (max-width: 800px) {
    .profile {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .career div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
