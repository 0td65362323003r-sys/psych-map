---
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../i18n/ui';
import CtaBlock from './CtaBlock.astro';
import { Image } from 'astro:assets';
import { profileImage } from '../data/works';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const d = ui.designer;
// 「 / 」で区切った実績を1件ずつに分け、英数字の名前（MISS GOLF 2023 など）は途中で改行しないようにする
const splitCareer = (p: string) =>
  p.split(/\s*\/\s+/).map((item) => (lang === 'ja' ? item.replace(/([A-Za-z0-9\u2019]) (?=[A-Za-z0-9])/g, '$1\u00a0') : item));
---

<Base lang={lang} path="designer/" title={ui.seo.designer.title} description={ui.seo.designer.desc}>
  <header class="page-head wrap">
    <h1>{d.name}</h1>
    {d.kana && <p class="sub">{d.kana}</p>}
    <p class="sub">{d.role}</p>
  </header>

  <section class="section">
    <div class="wrap profile">
      <figure>
        <Image src={profileImage} alt={d.name} widths={[480, 800, 1200]} sizes="(max-width: 800px) 100vw, 40vw" loading="eager" />
      </figure>
      <div>{d.profile.map((p) => <p>{p}</p>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <h2>{d.viewTitle}</h2>
      {d.view.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{d.careerTitle}</h2>
      <dl class="career">
        {
          d.career.map((c) => (
            <div>
              <dt>{c.h}</dt>
              <dd>
                <ul>{splitCareer(c.p).map((item) => <li>{item}</li>)}</ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CtaBlock lang={lang} />
</Base>

<style>
  .profile {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: 56px;
    align-items: start;
  }
  .profile figure {
    margin: 0;
  }
  .profile :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center 30%;
  }
  .profile p:first-child {
    margin-top: 0;
  }
  .career {
    margin: 0;
  }
  .career div {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .career dt {
    color: var(--gold);
  }
  .career ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .career li + li {
    margin-top: 4px;
  }
  .career dd {
    margin: 0;
    font-size: 14px;
  }
  @media (max-width: 800px) {
    .profile {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .career div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
