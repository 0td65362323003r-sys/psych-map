---
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const d = ui.designer;
---

<Base lang={lang} path="designer/" title={ui.seo.designer.title} description={ui.seo.designer.desc}>
  <header class="page-head wrap">
    <p class="eyebrow">Designer</p>
    <h1>{d.name}</h1>
    {d.kana && <p class="sub">{d.kana}</p>}
    <p class="sub">{d.role}</p>
  </header>

  <section class="section">
    <div class="wrap profile">
      <div class="photo" role="img" aria-label={d.photoPending}><span>{d.photoPending}</span></div>
      <div>
        {d.profile.map((p) => <p>{p}</p>)}
        <h2>{d.viewTitle}</h2>
        {d.view.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{d.careerTitle}</h2>
      <dl class="career">
        {d.career.map((c) => <div><dt>{c.h}</dt><dd>{c.p}</dd></div>)}
      </dl>
    </div>
  </section>
</Base>

<style>
  .profile {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: 56px;
  }
  .photo {
    aspect-ratio: 3 / 4;
    background: var(--bg-soft);
    border: 1px dashed var(--line);
    display: grid;
    place-items: center;
    color: var(--text-sub);
    font-size: 13px;
    text-align: center;
    padding: 16px;
  }
  .career {
    margin: 0;
  }
  .career div {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .career dt {
    color: var(--gold);
  }
  .career dd {
    margin: 0;
    font-size: 14px;
  }
  @media (max-width: 800px) {
    .profile {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .career div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
