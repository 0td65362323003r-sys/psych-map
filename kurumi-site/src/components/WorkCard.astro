---
import { Image } from 'astro:assets';
import { localePath, type Lang } from '../i18n/ui';
import type { Work } from '../data/works';

interface Props {
  work: Work;
  lang: Lang;
}
const { work, lang } = Astro.props;
---

{/* 一覧では写真だけを並べる（作品名と種類は、開いた先のページで出す） */}
<a class="card" href={localePath(lang, `collection/${work.id}/`)} aria-label={work.name[lang]}>
  <Image src={work.images[0]} alt="" widths={[400, 720]} sizes="(max-width: 800px) 50vw, 33vw" />
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
  }
  .card :global(img) {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    object-position: center 35%;
    transition: opacity 0.3s;
  }
  .card:hover :global(img) {
    opacity: 0.85;
  }
</style>
