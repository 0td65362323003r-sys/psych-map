---
import { Image } from 'astro:assets';
import { t, localePath, type Lang } from '../i18n/ui';
import type { Work } from '../data/works';

interface Props {
  work: Work;
  lang: Lang;
}
const { work, lang } = Astro.props;
const ui = t(lang);
---

<a class="card" href={localePath(lang, `collection/${work.id}/`)}>
  <Image src={work.images[0]} alt={work.name[lang]} widths={[400, 720]} sizes="(max-width: 800px) 50vw, 33vw" />
  <span class="cat sub">{ui.categories[work.category]}</span>
  <span class="name">{work.name[lang]}</span>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
  }
  .card :global(img) {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    object-position: center 35%;
    transition: opacity 0.3s;
  }
  .card:hover :global(img) {
    opacity: 0.85;
  }
  .card:hover .name {
    color: var(--gold);
  }
  .cat {
    display: block;
    margin-top: 12px;
    font-size: 12px;
    letter-spacing: 0.1em;
  }
  .name {
    display: block;
  }
</style>
