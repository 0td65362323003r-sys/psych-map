---
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../i18n/ui';
import CtaBlock from './CtaBlock.astro';
import { Image } from 'astro:assets';
import { works } from '../data/works';
const flowImage = works.find((w) => w.id === 'look-04')!;

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const o = ui.order;
---

<Base lang={lang} path="order/" title={ui.seo.order.title} description={ui.seo.order.desc}>
  <header class="page-head wrap">
    <h1>{o.title}</h1>
    <p class="lead">{o.lead}</p>
  </header>

  <section class="section">
    <div class="wrap">
      <h2>{o.priceTitle}</h2>
      <dl class="prices">
        {ui.prices.map((p) => <div><dt>{p.item}</dt><dd>{p.price}</dd></div>)}
      </dl>
      <p class="sub small">{ui.priceNote}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap flow-wrap">
      <div>
        <h2>{o.flowTitle}</h2>
        <ol class="flow">
          {o.flow.map((f, i) => <li><span class="num">0{i + 1}</span><h3>{f.h}</h3><p>{f.p}</p></li>)}
        </ol>
      </div>
      <Image src={flowImage.images[1]} alt={flowImage.name[lang]} widths={[480, 900]} sizes="(max-width: 800px) 100vw, 45vw" class="flow-img" />
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div>
        <h2>{o.scenesTitle}</h2>
        <ul class="scenes">{o.scenes.map((s) => <li>{s}</li>)}</ul>
      </div>
      <div>
        <h2>{o.voicesTitle}</h2>
        <ul class="voices">{o.voices.map((v) => <li><blockquote>{v}</blockquote></li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{o.faqTitle}</h2>
      <dl class="faq">
        {o.faq.map((f) => <div><dt>{f.q}</dt><dd>{f.a}</dd></div>)}
      </dl>
    </div>
  </section>

  <CtaBlock lang={lang} />
</Base>

<style>
  /* 値札のように、品目と価格を1行ずつ並べる */
  .prices {
    max-width: 520px;
    margin: 0 0 16px;
  }
  .prices div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .prices dt {
    color: var(--text-sub);
  }
  .prices dd {
    margin: 0;
    font-size: 22px;
    color: var(--gold);
  }
  .small {
    font-size: 12px;
  }
  .flow {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 32px;
  }
  .flow-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .flow-img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .num {
    font-family: var(--serif-en);
    color: var(--gold);
    font-size: 28px;
  }
  .flow h3 {
    font-weight: 500;
    margin: 4px 0;
  }
  .flow p {
    margin: 0;
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
  }
  .scenes,
  .voices {
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .scenes li,
  .voices li {
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .voices blockquote {
    margin: 0;
    padding-left: 16px;
    border-left: 1px solid var(--gold);
  }
  .faq {
    margin: 0;
  }
  .faq div {
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .faq dt {
    color: var(--gold);
  }
  .faq dd {
    margin: 4px 0 0;
  }
  @media (max-width: 800px) {
    .flow-wrap,
    .two {
      grid-template-columns: 1fr;
    }
  }
</style>
