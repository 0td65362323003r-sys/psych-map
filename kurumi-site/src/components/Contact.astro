---
import Base from '../layouts/Base.astro';
import { t, localePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const c = ui.contact;
const f = c.fields;
// 問い合わせを受けるGoogle Apps ScriptのURL。Cloudflareの環境変数で設定する
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? '';
---

<Base lang={lang} path="contact/" title={ui.seo.contact.title} description={ui.seo.contact.desc}>
  <header class="page-head wrap">
    <p class="eyebrow">Contact</p>
    <h1>{c.title}</h1>
    <p class="lead">{c.lead}</p>
  </header>

  <section class="wrap form-wrap">
    <form id="contact" data-endpoint={endpoint} data-sending={c.sending} data-submit={c.submit} novalidate>
      <input type="hidden" name="lang" value={lang} />
      <input type="hidden" name="ref" value="" />
      <!-- 迷惑送信よけ。人には見えない欄で、入力があれば保存しない -->
      <div class="hp" aria-hidden="true">
        <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>

      <label class="field">
        <span>{f.name}<em>{c.required}</em></span>
        <input type="text" name="name" required autocomplete="name" />
      </label>
      <label class="field">
        <span>{f.email}<em>{c.required}</em></span>
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <fieldset class="field">
        <legend>{f.item}<em>{c.required}</em></legend>
        <div class="options">
          {f.items.map((v, i) => <label class="opt"><input type="radio" name="item" value={v} required={i === 0} />{v}</label>)}
        </div>
      </fieldset>
      <fieldset class="field">
        <legend>{f.budget}</legend>
        <div class="options">
          {f.budgets.map((v) => <label class="opt"><input type="radio" name="budget" value={v} />{v}</label>)}
        </div>
      </fieldset>
      <label class="field">
        <span>{f.date}</span>
        <input type="date" name="date" />
      </label>
      <fieldset class="field">
        <legend>{f.scene}</legend>
        <div class="options">
          {f.scenes.map((v) => <label class="opt"><input type="checkbox" name="scene" value={v} />{v}</label>)}
        </div>
      </fieldset>
      <fieldset class="field">
        <legend>{f.fabric}</legend>
        <div class="options">
          {f.fabrics.map((v) => <label class="opt"><input type="radio" name="fabric" value={v} />{v}</label>)}
        </div>
      </fieldset>
      <label class="field">
        <span>{f.message}</span>
        <textarea name="message" rows="6"></textarea>
      </label>

      <p class="sub small">{c.privacyNote} <a href={localePath(lang, 'privacy/')}>{ui.footer.privacy}</a></p>
      {!endpoint && <p class="sub small">{c.notReady}</p>}
      <p class="status" role="status" aria-live="polite"></p>
      <button class="btn" type="submit">{c.submit}</button>
    </form>
    <p class="thanks" hidden>{c.thanks}</p>
    <p class="error-msg" hidden>{c.error}</p>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact')!;
  const thanks = document.querySelector<HTMLElement>('.thanks')!;
  const errorMsg = document.querySelector<HTMLElement>('.error-msg')!;
  const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

  // 作品ページから来たときは、どの作品かを一緒に送る
  const ref = new URLSearchParams(location.search).get('ref');
  if (ref) form.querySelector<HTMLInputElement>('input[name=ref]')!.value = ref;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.hidden = true;
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    if (data.get('website')) return;
    const body = new URLSearchParams();
    for (const [k, v] of data) body.append(k, String(v));
    body.set('scene', data.getAll('scene').join('、'));

    button.disabled = true;
    button.textContent = form.dataset.sending!;
    try {
      if (!form.dataset.endpoint) throw new Error('not connected');
      // Google Apps Script は CORS に対応していないので no-cors で送る（結果は読めない）
      await fetch(form.dataset.endpoint, { method: 'POST', mode: 'no-cors', body });
      form.hidden = true;
      thanks.hidden = false;
      window.scrollTo({ top: 0 });
    } catch {
      errorMsg.hidden = false;
      button.disabled = false;
      button.textContent = form.dataset.submit!;
    }
  });
</script>

<style>
  .form-wrap {
    max-width: 720px;
    padding-bottom: 96px;
  }
  .field {
    display: block;
    border: 0;
    padding: 0;
    margin: 0 0 28px;
  }
  .field > span,
  legend {
    display: block;
    margin-bottom: 8px;
    padding: 0;
  }
  em {
    font-style: normal;
    font-size: 11px;
    color: var(--gold);
    border: 1px solid var(--gold);
    padding: 0 6px;
    margin-left: 8px;
  }
  input[type='text'],
  input[type='email'],
  input[type='date'],
  textarea {
    width: 100%;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    color: var(--text);
    font: inherit;
    font-size: 16px;
    padding: 12px;
  }
  input:focus,
  textarea:focus {
    outline: 1px solid var(--gold);
    outline-offset: 0;
  }
  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .opt {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }
  .opt input {
    accent-color: var(--gold);
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .small {
    font-size: 12px;
  }
  .thanks,
  .error-msg {
    border: 1px solid var(--gold);
    padding: 24px;
  }
</style>
