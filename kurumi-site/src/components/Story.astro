---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../i18n/ui';
import { works } from '../data/works';
import CtaBlock from './CtaBlock.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const s = ui.story;
const milanPhoto = works.find((w) => w.id === 'look-07')!.images[0];
// 章のあいだに挟む寄りの写真（1章目と3章目のあと）
const interludes: Record<number, { img: ImageMetadata; alt: string }> = {
  0: { img: works.find((w) => w.id === 'look-01')!.images[1], alt: works.find((w) => w.id === 'look-01')!.name[lang] },
  2: { img: works.find((w) => w.id === 'look-10')!.images[1], alt: works.find((w) => w.id === 'look-10')!.name[lang] },
};
---

<Base lang={lang} path="story/" title={ui.seo.story.title} description={ui.seo.story.desc}>
  <header class="page-head wrap">
    <h1>{s.title}</h1>
  </header>

  {
    s.sections.map((sec, i) => (
      <>
        <section class="section">
          <div class="wrap narrow">
            <h2>{sec.h}</h2>
            {sec.p.map((p) => <p>{p}</p>)}
          </div>
        </section>
        {interludes[i] && (
          <figure class={`interlude wrap ${Object.keys(interludes).indexOf(String(i)) % 2 ? 'right' : 'left'}`}>
            <Image src={interludes[i].img} alt={interludes[i].alt} widths={[480, 900]} sizes="(max-width: 800px) 100vw, 50vw" />
          </figure>
        )}
      </>
    ))
  }

  <section class="section">
    <div class="wrap narrow">
      <h2>{s.valuesTitle}</h2>
      <dl class="values">
        {s.values.map((v) => <div><dt>{v.h}</dt><dd>{v.p}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap milan">
      <Image src={milanPhoto} alt={s.milanAlt} widths={[480, 800]} sizes="(max-width: 800px) 100vw, 40vw" />
      <div>
        <h2>{s.milanTitle}</h2>
        {s.milan.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <h2>{s.futureTitle}</h2>
      {s.future.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <CtaBlock lang={lang} />
</Base>

<style>
  .interlude {
    margin: 112px auto 0;
  }
  .interlude :global(img) {
    width: min(100%, 640px);
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .interlude.right :global(img) {
    margin-left: auto;
  }
  .values {
    display: grid;
    gap: 24px;
    margin: 0;
  }
  .values dt {
    color: var(--gold);
    font-size: 18px;
  }
  .values dd {
    margin: 4px 0 0;
  }
  .milan {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: 56px;
    align-items: center;
  }
  .milan :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
  @media (max-width: 800px) {
    .milan {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
