---
import Base from '../layouts/Base.astro';
import WorkCard from './WorkCard.astro';
import CtaBlock from './CtaBlock.astro';
import { t, localePath, type Lang } from '../i18n/ui';
import { works, type Category } from '../data/works';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const c = ui.collection;
const cats = [...new Set(works.map((w) => w.category))] as Category[];
---

<Base lang={lang} path="collection/" title={ui.seo.collection.title} description={ui.seo.collection.desc}>
  <header class="page-head wrap">
    <h1>{c.title}</h1>
    <p class="lead">{c.lead}</p>
  </header>

  <section class="wrap">
    <div class="filters" role="group" aria-label={c.filterLabel}>
      <button type="button" data-cat="all" aria-pressed="true">{c.all}</button>
      {cats.map((cat) => <button type="button" data-cat={cat} aria-pressed="false">{ui.categories[cat]}</button>)}
    </div>
    <p class="visually-hidden" aria-live="polite" id="filter-status" data-template={c.filterStatus(999)}></p>
    <ul class="grid">
      {works.map((w) => <li data-cat={w.quote ? 'all-only' : w.category}><WorkCard work={w} lang={lang} /></li>)}
      {works.length % 3 === 2 && (
        <li class="fill-li" data-cat="all">
          <div class="fill">
            <p>{c.fillBody}</p>
            <a class="more" href={localePath(lang, 'contact/')}>{ui.cta}</a>
          </div>
        </li>
      )}
    </ul>
  </section>

  <section class="section glossary">
    <div class="wrap">
      <h2>{c.materialGlossaryTitle}</h2>
      <dl>
        {c.glossary.map((g) => <div><dt>{g.h}</dt><dd>{g.p}</dd></div>)}
      </dl>
    </div>
  </section>

  <CtaBlock lang={lang} />
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const items = document.querySelectorAll<HTMLLIElement>('.grid li');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      items.forEach((li) => (li.hidden = li.classList.contains('fill-li') ? b.dataset.cat !== 'all' : b.dataset.cat !== 'all' && li.dataset.cat !== b.dataset.cat));
      const status = document.getElementById('filter-status');
      if (status) {
        const n = [...items].filter((li) => !li.hidden && !li.classList.contains('fill-li')).length;
        status.textContent = (status.dataset.template ?? '').replace('999', String(n));
      }
    }),
  );
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }
  .filters button {
    background: none;
    border: 1px solid var(--field-border);
    color: var(--text-sub);
    font: inherit;
    font-size: 13px;
    padding: 10px 18px;
    min-height: 44px;
    cursor: pointer;
  }
  .filters button[aria-pressed='true'] {
    border-color: var(--gold);
    color: var(--text);
  }
  .grid {
    list-style: none;
    margin: 0 0 96px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px 24px;
  }
  /* 3列の最後の段が空くときは、オーダーへの案内で埋める */
  .fill {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 32px;
    border: 1px solid var(--line);
    aspect-ratio: 2 / 3;
  }
  .fill p {
    margin: 0 0 16px;
  }
  @media (max-width: 800px) {
    .fill {
      padding: 16px;
      font-size: 14px;
      aspect-ratio: auto;
      height: 100%;
    }
  }
  .glossary dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin: 0;
  }
  .glossary dt {
    color: var(--gold);
  }
  .glossary dd {
    margin: 4px 0 0;
    font-size: 14px;
  }
  @media (max-width: 800px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 12px;
    }
    .glossary dl {
      grid-template-columns: 1fr;
    }
  }
</style>
