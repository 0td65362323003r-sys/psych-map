---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkCard from './WorkCard.astro';
import { t, localePath, type Lang } from '../i18n/ui';
import { works, heroImage, storyImage } from '../data/works';
import { getPosts, formatDate } from '../lib/microcms';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const pickup = ['look-08', 'look-02', 'look-04'].map((id) => works.find((w) => w.id === id)!);
// 生地の見本帳。生地が大きく写っている写真を選び、その位置を拡大して短冊にする
const swatchFocus: Record<string, { img: number; pos: string }> = {
  'look-01': { img: 1, pos: '52% 55%' },
  'look-02': { img: 1, pos: '45% 62%' },
  'look-03': { img: 0, pos: '24% 52%' },
  'look-04': { img: 0, pos: '90% 76%' },
  'look-05': { img: 0, pos: '40% 52%' },
  'look-06': { img: 1, pos: '50% 62%' },
  'look-07': { img: 2, pos: '42% 78%' },
  'look-08': { img: 0, pos: '50% 74%' },
  'look-09': { img: 1, pos: '60% 92%' },
  'look-10': { img: 1, pos: '50% 42%' },
  'look-11': { img: 0, pos: '62% 88%' },
};
const posts = (await getPosts(lang)).slice(0, 3);
const og = await getImage({ src: heroImage, width: 1200, format: 'jpg' });
---

<Base lang={lang} path="" title={ui.seo.home.title} description={ui.seo.home.desc} image={og.src}>
  <section class="hero">
    <Image src={heroImage} alt="" widths={[640, 1024, 1600]} sizes="(min-width: 900px) 46vw, 100vw" class="hero-img" loading="eager" fetchpriority="high" />
    <div class="hero-text wrap">
      <h1 class="hero-catch">{ui.philosophy.split(/(?<=[。.,、])\s*/).filter(Boolean).map((line) => <span>{line}</span>)}</h1>
      <p class="hero-sub">{ui.home.heroSub}</p>
      <a class="btn hero-cta" href={localePath(lang, 'contact/')}>{ui.cta}</a>
    </div>
  </section>

  <section class="section concept">
    <div class="wrap">
      <h2>{ui.home.conceptTitle}</h2>
      <p class="lead">{ui.home.conceptBody}</p>
      <nav class="swatches" aria-label={ui.home.swatchLabel}>
        <p class="sub swatch-label">{ui.home.swatchLabel}</p>
        <ul>
          {
            works.map((w) => (
              <li>
                <a class="swatch" href={localePath(lang, `collection/${w.id}/`)} title={w.name[lang]} style={`--focus: ${swatchFocus[w.id].pos}`}>
                  <Image src={w.images[swatchFocus[w.id].img]} alt={w.name[lang]} widths={[400, 800]} sizes="(max-width: 800px) 80vw, 360px" loading="lazy" />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{ui.home.collectionTitle}</h2>
      <p class="sub">{ui.home.collectionBody}</p>
      <ul class="grid">
        {pickup.map((w) => <li><WorkCard work={w} lang={lang} /></li>)}
      </ul>
      <a class="more" href={localePath(lang, 'collection/')}>{ui.home.collectionMore}</a>
    </div>
  </section>

  <section class="section split">
    <div class="wrap split-inner">
      <Image src={storyImage} alt="" widths={[480, 800]} sizes="(max-width: 800px) 100vw, 45vw" class="split-img" />
      <div>
        <h2>{ui.home.storyTitle}</h2>
        <p class="lead">{ui.home.storyBody}</p>
        <a class="more" href={localePath(lang, 'story/')}>{ui.home.storyMore}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap pair">
      <div>
        <h2>{ui.home.designerTitle}</h2>
        <p>{ui.home.designerBody}</p>
        <a class="more" href={localePath(lang, 'designer/')}>{ui.home.designerMore}</a>
      </div>
      <div>
        <h2>{ui.home.orderTitle}</h2>
        <dl class="prices">
          {ui.prices.map((p) => <div><dt>{p.item}</dt><dd>{p.price}</dd></div>)}
        </dl>
        <p class="sub small">{ui.priceNote}</p>
        <p>{ui.home.orderBody}</p>
        <a class="more" href={localePath(lang, 'order/')}>{ui.home.orderMore}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{ui.home.voicesTitle}</h2>
      <ul class="voices">
        {ui.order.voices.slice(0, 3).map((v) => <li><blockquote>{v}</blockquote></li>)}
      </ul>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section">
        <div class="wrap">
          <h2>{ui.journal.title}</h2>
          <ul class="posts">
            {posts.map((p) => (
              <li>
                <a href={localePath(lang, `journal/${p.id}/`)}>
                  <time class="sub">{formatDate(p.publishedAt, lang)}</time>
                  <span>{p.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section final">
    <div class="wrap">
      <h2>{ui.home.finalTitle}</h2>
      <p class="lead">{ui.home.finalBody}</p>
      <a class="btn" href={localePath(lang, 'contact/')}>{ui.cta}</a>
    </div>
  </section>
</Base>

<style>
  /* スマホ：写真の下に文字を置く（写真に文字を重ねない） */
  .hero {
    position: relative;
    overflow: hidden;
  }
  .hero-img {
    position: relative;
    width: 100%;
    height: 78svh;
    min-height: 460px;
    object-fit: cover;
    object-position: center 40%;
  }
  /* 上はメニュー、下はキャッチコピーを読みやすくするための影 */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 78svh;
    min-height: 460px;
    pointer-events: none;
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--bg) 60%, transparent) 0%, transparent 18%),
      linear-gradient(to top, var(--bg) 0%, transparent 22%);
  }
  .hero-text {
    position: relative;
    z-index: 1;
    margin-top: -24px;
  }
  .hero-cta {
    margin-top: 32px;
  }
  .hero-catch span {
    display: block;
    text-wrap: balance;
  }
  .hero-catch {
    font-weight: 500;
    font-size: clamp(28px, 7vw, 48px);
    margin: 0;
    line-height: 1.4;
  }
  .hero-sub {
    margin: 16px 0 0;
    color: var(--text-sub);
  }
  @media (min-width: 900px) {
    .hero {
      height: 100svh;
      min-height: 620px;
    }
    .hero-img {
      position: absolute;
      inset: 0 0 0 auto;
      width: 46%;
      height: 100%;
      min-height: 0;
      object-position: center 62%;
    }
    .hero::after {
      height: 100%;
      background: linear-gradient(to bottom, color-mix(in srgb, var(--bg) 75%, transparent) 0%, transparent 18%);
    }
    .hero-text {
      position: absolute;
      left: 0;
      right: 0;
      top: 50%;
      margin-top: 0;
      transform: translateY(-50%);
    }
    .hero-catch {
      font-size: clamp(36px, 3.6vw, 54px);
      max-width: 11em;
    }
    .hero-sub {
      max-width: 26em;
      margin-top: 24px;
    }
  }
  .split-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .split-img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .prices {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: 0 0 8px;
  }
  .prices div {
    display: flex;
    gap: 12px;
    align-items: baseline;
  }
  .prices dt {
    color: var(--text-sub);
  }
  .prices dd {
    margin: 0;
    font-size: 22px;
    color: var(--gold);
  }
  .small {
    font-size: 12px;
  }
  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .posts a {
    display: flex;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .voices {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .voices blockquote {
    margin: 0;
    padding-left: 16px;
    border-left: 1px solid var(--gold);
    font-size: 17px;
    line-height: 1.8;
  }
  .final .lead {
    margin-bottom: 32px;
  }
  .swatches {
    margin-top: 56px;
  }
  .swatch-label {
    font-size: 13px;
    margin: 0 0 12px;
  }
  .swatches ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(11, minmax(0, 1fr));
    gap: 2px;
  }
  .swatch {
    display: block;
    aspect-ratio: 1 / 3;
    overflow: hidden;
    outline-offset: 2px;
  }
  .swatch :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus);
    transform: scale(3.5);
    transform-origin: var(--focus);
    transition: transform 0.4s ease;
  }
  .swatch:hover :global(img),
  .swatch:focus-visible :global(img) {
    transform: scale(3);
  }
  .pair .prices {
    flex-direction: column;
    gap: 4px;
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }
  @media (prefers-reduced-motion: reduce) {
    .swatch :global(img) {
      transition: none;
    }
  }
  @media (max-width: 800px) {
    .swatches ul {
      display: flex;
      overflow-x: auto;
      padding-bottom: 8px;
    }
    .swatches ul {
      mask-image: linear-gradient(to right, #000 85%, transparent);
    }
    .swatches li {
      flex: 0 0 22vw;
    }
    .pair,
    .voices,
    .split-inner,
    .grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
