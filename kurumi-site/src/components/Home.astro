---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkCard from './WorkCard.astro';
import { t, localePath, type Lang } from '../i18n/ui';
import { works, heroImage, storyImage } from '../data/works';
import { getPosts, formatDate } from '../lib/microcms';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
// TOPの作品3枚（2026年11月 胡桃さんから指定）。メンズを真ん中に置く
const pickup = ['look-06', 'men-01', 'look-10'].map((id) => works.find((w) => w.id === id)!);
const posts = (await getPosts(lang)).slice(0, 3);
const og = await getImage({ src: heroImage, width: 1200, format: 'jpg' });
---

<Base lang={lang} path="" title={ui.seo.home.title} description={ui.seo.home.desc} image={og.src}>
  <section class="hero">
    <Image src={heroImage} alt="" widths={[640, 1024, 1600]} sizes="(min-width: 900px) 46vw, 100vw" class="hero-img" loading="eager" fetchpriority="high" />
    <div class="hero-text wrap">
      <h1 class="hero-catch">{ui.philosophy.split(/(?<=[。.,、])\s*/).filter(Boolean).map((line, i) => <span>{i > 0 && ' '}{line}</span>)}</h1>
      <p class="hero-sub">{ui.home.heroSub}</p>
      <a class="btn hero-cta" href={localePath(lang, 'contact/')}>{ui.cta}</a>
    </div>
  </section>

  {/* ショー映像（胡桃さん提供の全編。最後のロゴは切ってある）。普段は小さく音なしで流し、押すと大きく音ありで見られる */}
  <section class="section film">
    <div class="wrap">
      <h2 class="film-title">{ui.home.videoTitle}</h2>
      <p class="sub">{ui.home.videoBody}</p>
      <div class="film-frame">
        <video class="film-video" src="/video/show.mp4" poster="/video/show-poster.jpg" autoplay muted loop playsinline preload="metadata" aria-label={ui.home.videoLabel}></video>
        <div class="film-actions">
          <button class="film-expand" type="button">{ui.home.videoExpand}</button>
          <button class="film-toggle" type="button" data-pause={ui.home.videoPause} data-play={ui.home.videoPlay}>{ui.home.videoPause}</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section concept">
    <div class="wrap">
      <h2>{ui.home.conceptTitle}</h2>
      <p class="lead">{ui.home.conceptBody}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{ui.home.collectionTitle}</h2>
      <p class="sub">{ui.home.collectionBody}</p>
      <ul class="grid">
        {pickup.map((w) => <li><WorkCard work={w} lang={lang} /></li>)}
      </ul>
      <a class="more" href={localePath(lang, 'collection/')}>{ui.home.collectionMore}</a>
    </div>
  </section>

  <section class="section split">
    <div class="wrap split-inner">
      <Image src={storyImage} alt="" widths={[480, 800]} sizes="(max-width: 800px) 100vw, 45vw" class="split-img" />
      <div>
        <h2>{ui.home.storyTitle}</h2>
        <p class="lead">{ui.home.storyBody}</p>
        <a class="more" href={localePath(lang, 'story/')}>{ui.home.storyMore}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap pair">
      <div>
        <h2>{ui.home.designerTitle}</h2>
        <p>{ui.home.designerBody}</p>
        <a class="more" href={localePath(lang, 'designer/')}>{ui.home.designerMore}</a>
      </div>
      <div>
        <h2>{ui.home.orderTitle}</h2>
        <dl class="prices">
          {ui.prices.map((p) => <div><dt>{p.item}</dt><dd>{p.price}<span class="tax">{ui.collection.priceTax}</span></dd></div>)}
        </dl>
        <p class="sub small">{ui.priceNote}</p>
        <p>{ui.home.orderBody}</p>
        <a class="more" href={localePath(lang, 'order/')}>{ui.home.orderMore}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{ui.home.voicesTitle}</h2>
      <ul class="voices">
        {ui.order.voices.slice(0, 3).map((v) => <li><blockquote>{v}</blockquote></li>)}
      </ul>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section">
        <div class="wrap">
          <h2>{ui.journal.title}</h2>
          <ul class="posts">
            {posts.map((p) => (
              <li>
                <a href={localePath(lang, `journal/${p.id}/`)}>
                  <time class="sub">{formatDate(p.publishedAt, lang)}</time>
                  <span>{p.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section final">
    <div class="wrap">
      <h2>{ui.home.finalTitle}</h2>
      <p class="lead">{ui.home.finalBody}</p>
      <a class="btn" href={localePath(lang, 'contact/')}>{ui.cta}</a>
    </div>
  </section>
</Base>

<script>
  const video = document.querySelector<HTMLVideoElement>('.film-video');
  const toggle = document.querySelector<HTMLButtonElement>('.film-toggle');
  const expand = document.querySelector<HTMLButtonElement>('.film-expand');
  if (video && toggle && expand) {
    const sync = () => (toggle.textContent = video.paused ? toggle.dataset.play! : toggle.dataset.pause!);
    // 音なしなら自動で流れる。省電力の設定などで止まったときは、最初に画面に触れたときに流す
    const start = () => {
      video.muted = true;
      video.play().catch(() => {});
    };
    start();
    document.addEventListener('touchstart', () => video.paused && !video.dataset.userPaused && start(), { once: true, passive: true });
    toggle.addEventListener('click', () => {
      if (video.paused) {
        delete video.dataset.userPaused;
        video.play();
      } else {
        video.dataset.userPaused = '1';
        video.pause();
      }
    });
    // 大きく見るときは、音ありで操作ボタンを出す。戻ったら小さく音なしに戻す
    const open = () => {
      video.muted = false;
      video.controls = true;
      video.play().catch(() => {});
      const v = video as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
      if (video.requestFullscreen) video.requestFullscreen().catch(() => v.webkitEnterFullscreen?.());
      else v.webkitEnterFullscreen?.();
    };
    const close = () => {
      video.muted = true;
      video.controls = false;
      video.play().catch(() => {});
    };
    expand.addEventListener('click', open);
    video.addEventListener('click', () => !document.fullscreenElement && open());
    document.addEventListener('fullscreenchange', () => !document.fullscreenElement && close());
    video.addEventListener('webkitendfullscreen', close);
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    sync();
  }
</script>

<style>
  /* スマホ：写真の下に文字を置く（写真に文字を重ねない） */
  /* スマホ：写真はヘッダーの下から始め、見出しは写真の下に置く（写真や線に文字を重ねない） */
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: 76px;
  }
  .hero-img {
    display: block;
    object-fit: cover;
    object-position: center 30%;
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    object-position: center top;
    outline: none;
  }
  /* 上はメニュー、下はキャッチコピーを読みやすくするための影 */
  .hero::after {
    content: '';
    position: absolute;
    inset: 76px 0 auto;
    height: 0;
    pointer-events: none;
  }
  .hero-text {
    position: relative;
    z-index: 1;
    margin-top: 32px;
  }
  .hero-cta {
    margin-top: 32px;
  }
  .hero-catch span {
    display: block;
    text-wrap: balance;
  }
  .hero-catch {
    font-weight: 500;
    font-size: clamp(28px, 7vw, 48px);
    margin: 0;
    line-height: 1.4;
  }
  .hero-sub {
    margin: 16px 0 0;
    color: var(--text-sub);
  }
  @media (min-width: 900px) {
    .hero {
      height: 100svh;
      min-height: 620px;
      padding-top: 0;
    }
    .hero-img {
      position: absolute;
      inset: 0 0 0 auto;
      width: 46%;
      height: 100%;
      min-height: 0;
      object-position: center 62%;
    }
    .hero::after {
      top: 0;
      height: 100%;
      background: linear-gradient(to bottom, color-mix(in srgb, var(--bg) 75%, transparent) 0%, transparent 18%);
    }
    .hero-text {
      position: absolute;
      left: 0;
      right: 0;
      top: 50%;
      margin-top: 0;
      transform: translateY(-50%);
    }
    .hero-catch {
      font-size: clamp(36px, 3.6vw, 54px);
      max-width: 11em;
    }
    .hero-sub {
      max-width: 26em;
      margin-top: 24px;
    }
  }
  .split-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .split-img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .prices {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: 0 0 8px;
  }
  .prices div {
    display: flex;
    gap: 12px;
    align-items: baseline;
  }
  .prices dt {
    color: var(--text-sub);
  }
  .prices dd {
    margin: 0;
    font-size: 22px;
    color: var(--gold);
  }
  .small {
    font-size: 12px;
  }
  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .posts a {
    display: flex;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .voices {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .voices blockquote {
    margin: 0;
    padding-left: 16px;
    border-left: 1px solid var(--gold);
    font-size: 17px;
    line-height: 1.8;
  }
  .final .lead {
    margin-bottom: 32px;
  }
  .pair .prices {
    flex-direction: column;
    gap: 4px;
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }
  @media (max-width: 800px) {
    /* スマホでは5本×2段にして、スクロールしなくても虹の並びが見えるようにする */
    .pair,
    .voices,
    .split-inner,
    .grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  .film-title {
    font-family: var(--display);
    font-weight: 400;
  }
  .film-frame {
    position: relative;
    margin-top: 32px;
    max-width: 880px;
  }
  .film-video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    cursor: zoom-in;
  }
  .film-actions {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }
  .film-actions button {
    background: none;
    border: 1px solid var(--field-border);
    color: var(--text);
    font: inherit;
    font-size: 13px;
    padding: 8px 14px;
    min-height: 40px;
    cursor: pointer;
  }
  .film-expand {
    border-color: var(--gold) !important;
  }
  .tax {
    font-size: 12px;
    color: var(--text-sub);
    margin-left: 4px;
  }
</style>
